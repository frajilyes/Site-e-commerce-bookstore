{
  "compilerOptions": {
    "baseUrl": "src",
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./Component/*"],
      "@pages/*": ["./pages/*"],
      "@hooks/*": ["./hooks/*"],
      "@utils/*": ["./utils/*"],
      "@services/*": ["./services/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "build"]
}
